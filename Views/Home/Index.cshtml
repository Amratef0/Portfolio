    <script>
        let dark = false;

          document.getElementById("btnnnn").onclick = function () {
            document.body.classList.toggle("dark-mode");
            dark = !dark;

            this.innerHTML = dark
              ? '<i class="fa-regular fa-moon" style="color: #FFA500;"></i>'
              : '<i class="fa-solid fa-sun" style="color: #FFD700;"></i>';
          };
