    <section class="contact" id="contact">
        <h2 class="heading">Contact <span>Me</span></h2>
        <form asp-action="SaveContactMe" method="POST">
            <div class="input-group">
                <div class="input-box">
                    <input type="hidden" name="access_key" value="fe4ed07a-1f18-4cf4-a361-e9647b8ed6a0" />

                    <input asp-for="FullName" type="text" placeholder="Full name" required
                           data-aos="fade-right" data-aos-delay="100" data-aos-duration="1000" />
                    <span asp-validation-for="FullName" class="text-danger"></span>

                    <input asp-for="Email" type="email" placeholder="Email" required
                           data-aos="fade-right" data-aos-delay="200" data-aos-duration="1000" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="input-box">
                    <input asp-for="PhoneNumber" type="tel" placeholder="Phone Number" required
                           data-aos="fade-right" data-aos-delay="300" data-aos-duration="1000" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>

                    <input asp-for="Subject" type="text" placeholder="Subject" required
                           data-aos="fade-right" data-aos-delay="400" data-aos-duration="1000" />
                    <span asp-validation-for="Subject" class="text-danger"></span>
                </div>
            </div>

            <div class="input-group-2">
                <textarea asp-for="Message" cols="30" rows="10" placeholder="Your Message" required
                          data-aos="fade-left" data-aos-delay="500" data-aos-duration="1000"></textarea>
                <span asp-validation-for="Message" class="text-danger"></span>

                <input type="submit" value="Send Message" class="btn" />
            </div>
        </form>
    </section>



